# MiniCode 环境变量（复制为 .env 填写）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL=Qwen/Qwen2.5-7B-Instruct

# Agent 循环护栏
MINICODE_MAX_ITERATIONS=10
MINICODE_TEMPERATURE=0.2
MINICODE_MAX_TOKENS=2048

# 执行器
MINICODE_EXEC_TIMEOUT=10
MINICODE_WORKSPACE=./workspace

# Mock 模式（无 Key 先跑通链路用，数字不进简历）
MOCK_MODE=false
